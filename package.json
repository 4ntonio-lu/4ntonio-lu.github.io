{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://4ntonio-lu.github.io/",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "predeploy": "npm run build && copy dist\\index.html dist\\404.html",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:schemas": "node scripts/content/generate-schemas.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "worker:dev": "npm --prefix cloudflare-worker run dev",
    "worker:deploy": "npm --prefix cloudflare-worker run deploy"
  },
  "dependencies": {
    "chart.js": "^4.4.9",
    "chartjs-chart-financial": "^0.2.1",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.4.6",
    "react-router-dom": "^7.18.5",
    "react-tabs": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
