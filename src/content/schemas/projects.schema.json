{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path to the JSON Schema, for editor support.",
      "type": "string"
    },
    "projects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "pattern": "^[\\w.-]+\\.(png|jpe?g|gif|svg|webp)$",
            "description": "File name of an image in src/assets/images."
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "First month, as \"YYYY-MM\".",
            "examples": [
              "2024-05"
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last month as \"YYYY-MM\", or null if it's ongoing (shown as \"Present\").",
            "examples": [
              "2024-09",
              null
            ]
          },
          "skills": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "link": {
            "description": "Optional link to the code or a live demo.",
            "type": "string",
            "pattern": "^(https?:\\/\\/|mailto:)\\S+$"
          },
          "bullets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "image",
          "start",
          "end",
          "skills",
          "bullets"
        ],
        "additionalProperties": false
      },
      "description": "Shown newest first, so the order here doesn't matter."
    }
  },
  "required": [
    "projects"
  ],
  "additionalProperties": false
}
